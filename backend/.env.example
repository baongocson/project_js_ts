PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_ENABLED=false
# Required when DATABASE_ENABLED=true; generate locally, never commit a real secret.
AUTH_ACCESS_TOKEN_SECRET=
AUTH_TOKEN_ISSUER=dashboard-3d
AUTH_TOKEN_AUDIENCE=dashboard-3d-frontend
AUTH_REGISTER_LIMIT=10
AUTH_LOGIN_LIMIT=60
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_REFRESH_LIMIT=60
AUTH_LOGOUT_LIMIT=60
# Single-process account cleanup resumes deleting users at startup/every minute.
ACCOUNT_CLEANUP_ENABLED=true
# ORIGINAL_STORAGE_ROOT defaults to backend/storage/originals; keys are relative to this root.
MONGODB_URI=mongodb://127.0.0.1:27017/dashboard_3d?replicaSet=rs0
MONGODB_DB_NAME=dashboard_3d
# Optional process-only DNS override if system DNS cannot resolve Atlas SRV.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
