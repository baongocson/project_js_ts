{
  "name": "@dashboard/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run build -w @dashboard/data-core",
    "pretypecheck": "npm run build -w @dashboard/data-core",
    "pretest:unit": "npm run build -w @dashboard/data-core",
    "pretest:e2e": "npm run build -w @dashboard/data-core",
    "pretest:integration": "npm run build -w @dashboard/data-core",
    "prestart:dev": "npm run build -w @dashboard/data-core",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json && npm run check:architecture",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:contracts": "jest --config jest.config.cjs --runInBand --selectProjects unit --testPathIgnorePatterns=auth.service.spec.ts",
    "test:http": "jest --config jest.config.cjs --runInBand --selectProjects e2e",
    "db:provision": "npm run build && node dist/infrastructure/database/database.cli.js provision",
    "db:verify": "npm run build && node dist/infrastructure/database/database.cli.js verify",
    "test:database": "jest --config jest.config.cjs --runInBand --selectProjects integration",
    "test": "jest --config jest.config.cjs --runInBand --selectProjects unit",
    "test:unit": "jest --config jest.config.cjs --runInBand --selectProjects unit",
    "test:e2e": "jest --config jest.config.cjs --runInBand --selectProjects e2e",
    "test:integration": "jest --config jest.config.cjs --runInBand --selectProjects integration",
    "test:be2:local": "npm run build && node scripts/test-local-replica.cjs --be2",
    "test:integration:local": "npm run build && node scripts/test-local-replica.cjs",
    "test:watch": "jest --config jest.config.cjs --selectProjects unit --watch",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "test:be1": "jest --config jest.config.cjs --runInBand --selectProjects integration --runTestsByPath src/test/integration/modules/auth/auth.integration-spec.ts",
    "auth:init-secret": "node scripts/init-auth-secret.cjs",
    "db:upgrade:tfidf": "npm run build && node scripts/upgrade-tfidf-validator.cjs"
  },
  "dependencies": {
    "@dashboard/data-core": "0.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "mongoose": "^8.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "11.3.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  }
}
