{
  "name": "@dashboard/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:contracts": "npm run build && node --test test/contracts.test.cjs",
    "test:http": "npm run build && node --test test/http-contracts.test.cjs",
    "db:provision": "npm run build && node dist/infrastructure/database/database.cli.js provision",
    "db:verify": "npm run build && node dist/infrastructure/database/database.cli.js verify",
    "test:database": "npm run build && node --test test/database.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "mongoose": "^8.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
