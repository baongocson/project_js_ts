{
    auto_https disable_redirects
}

http://localhost {
    redir https://localhost:8443{uri} permanent
}

https://localhost {
    tls internal
    encode zstd gzip
    handle /api/* {
        reverse_proxy backend:3000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
